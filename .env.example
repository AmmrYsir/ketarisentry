# Application Environment Mode (development | staging | production)
VITE_APP_ENV="development"

# Application Server Port
PORT=3001

# SQLite Database File Path
DB_PATH="database/ketarisentry.db"

# Google OAuth 2.0 Client ID (Required for Google Sign-In in production)
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Restrict Google OAuth Sign-In to specific email domains (Optional, comma-separated)
VITE_ALLOWED_DOMAINS="company.com,tech.io"
